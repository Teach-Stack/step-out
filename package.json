    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
